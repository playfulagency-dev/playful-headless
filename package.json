{
  "name": "nextjs-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "24.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-budget.mjs",
    "build:direct": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rimraf .next",
    "test:seo": "node scripts/seo-smoke.mjs",
    "test:canonical": "node --experimental-strip-types --test tests/canonical.test.mjs tests/agencia-shopify.test.mjs tests/blog-service-cta.test.mjs tests/blog-listing-robots.test.mjs tests/blog-listing-pagination.test.mjs tests/amp-junk-query.test.mjs tests/blog-seo-redirect.test.mjs tests/blog-closed-posts.test.mjs tests/service-booking-cta.test.mjs tests/about-href.test.mjs tests/ecommerce-shopify-link.test.mjs tests/case-study-shopify-link.test.mjs tests/header-shopify-nav.test.mjs",
    "test:service-booking": "node --experimental-strip-types --test tests/service-booking-cta.test.mjs",
    "test:about-hrefs": "node --experimental-strip-types --test tests/about-href.test.mjs",
    "smoke:service-booking": "node --experimental-strip-types scripts/service-booking-cta-curl.mjs",
    "smoke:about-hrefs": "node --experimental-strip-types scripts/about-href-curl.mjs",
    "test:wordpress": "node --test tests/wordpress-*.test.mjs tests/page-seo-overrides.test.mjs",
    "test:blog-payload": "node --experimental-strip-types --test tests/blog-preview.test.mjs",
    "test:highlevel": "node --experimental-transform-types --test tests/highlevel/*.test.ts",
    "test:highlevel-evidence": "node --test tests/highlevel/redacted-export-audit.test.mjs",
    "audit:highlevel-export": "node scripts/highlevel-redacted-export-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test:route-integrity": "node --test tests/route-integrity.test.mjs",
    "verify:lockfile": "node scripts/verify-lockfile-install.mjs",
    "verify:routes": "node scripts/verify-route-artifact.mjs",
    "verify:routes:build": "node scripts/build-and-verify-routes.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/material-nextjs": "^7.3.2",
    "@next/third-parties": "^16.1.1",
    "@types/cheerio": "^0.22.35",
    "@types/html2canvas": "^0.5.35",
    "@types/jspdf": "^1.3.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-slick": "^0.23.13",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "next": "15.5.25",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-slick": "^0.31.0",
    "resend": "^6.4.2",
    "slick-carousel": "^1.8.1",
    "swiper": "^12.1.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "15.5.25",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  }
}
