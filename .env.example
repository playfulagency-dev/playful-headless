# WordPress API Configuration
WORDPRESS_API_URL=https://endpoint.playfulagency.com/wp-json

# Google reCAPTCHA v2 (Checkbox)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
WORDPRESS_CONTACT_TOKEN=your_random_server_to_server_contact_token
# Master switch for the durable delivery/CRM pipeline. False is the Redis-free
# rollback path: one WordPress attempt, no HighLevel call and no automatic retry.
CONTACT_PIPELINE_ENABLED=false
# Enable only after the WordPress endpoint with submission_id deduplication is deployed.
WORDPRESS_CONTACT_IDEMPOTENCY_ENABLED=false

# Durable contact-delivery reservation (required even when HighLevel is off)
CONTACT_IDEMPOTENCY_TTL_SECONDS=604800
CONTACT_PROCESSING_LEASE_SECONDS=30
CONTACT_IDEMPOTENCY_REDIS_REST_URL=
CONTACT_IDEMPOTENCY_REDIS_REST_TOKEN=

# HighLevel website lead integration (server-only; closed by default)
# Preview may use ENABLED=true + TEST_MODE=true to exercise the flow without
# sending any request to HighLevel. Production activation requires real IDs,
# a private integration token, and a durable Redis-compatible store.
HIGHLEVEL_ENABLED=false
HIGHLEVEL_TEST_MODE=true
# External tracking remains globally off until HighLevel Form Submissions is disabled.
NEXT_PUBLIC_HIGHLEVEL_EXTERNAL_TRACKING_ENABLED=false
HIGHLEVEL_EXTERNAL_FORM_SUBMISSIONS_DISABLED=false
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_PIPELINE_ID=
HIGHLEVEL_STAGE_CONSULTA_ID=
HIGHLEVEL_DEFAULT_OWNER_ID=
HIGHLEVEL_CONTACT_TAG=website-inbound
HIGHLEVEL_SLA_HOURS=
HIGHLEVEL_REQUEST_TIMEOUT_MS=8000
# Deprecated aliases accepted during migration:
HIGHLEVEL_IDEMPOTENCY_TTL_SECONDS=
HIGHLEVEL_PROCESSING_LEASE_SECONDS=
HIGHLEVEL_IDEMPOTENCY_REDIS_REST_URL=
HIGHLEVEL_IDEMPOTENCY_REDIS_REST_TOKEN=
# Required keys: original_source, original_landing, recent_source,
# recent_landing, utm_source, utm_medium, utm_campaign, utm_term,
# utm_content, form_id, privacy_consent_at, marketing_consent, decision_role,
# decision_role_other, sales_model, sales_model_other, secondary_marketplaces,
# monthly_revenue, monthly_revenue_other, project_timing, project_timing_other,
# qualification_level, project_context.
HIGHLEVEL_CUSTOM_FIELD_IDS_JSON={}

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
