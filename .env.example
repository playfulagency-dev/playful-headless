# WordPress API Configuration
WORDPRESS_API_URL=https://endpoint.playfulagency.com/wp-json

# Legacy WP pages default to noindex. Add only reviewed slugs, comma-separated.
WP_LEGACY_INDEXABLE_SLUGS=

# Google reCAPTCHA v2 (Checkbox)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
WORDPRESS_CONTACT_TOKEN=your_random_server_to_server_contact_token

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
